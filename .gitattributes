# Line endings: store LF in the repository and use LF in the working copy, on every OS.
# This overrides each machine's core.autocrlf setting, so diffs stay clean between
# Windows (development) and Linux (CI, Docker).
* text=auto eol=lf

# Windows-only scripts keep Windows line endings.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
